  Hi := AglCount - 1;
  Found := -1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) shr 1;
    if AglCodes[AglByCode[Mid]] < CodePoint then
      Lo := Mid + 1
    else
    begin
      if AglCodes[AglByCode[Mid]] = CodePoint then
        Found := Mid;
      Hi := Mid - 1;
    end;
  end;
  if Found >= 0 then
    Result := AglNames[AglByCode[Found]]
  else
    Result := '';
end;

end.
