<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{E4EC0D03-DB21-437F-99FB-CE5D34099F04}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="PdfEngine.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="PdfViewerFMX.dproj">
            <Dependencies>PdfEngine.dproj</Dependencies>
        </Projects>
        <Projects Include="PdfViewerFMXDsgn.dproj">
            <Dependencies>PdfViewerFMX.dproj</Dependencies>
        </Projects>
        <Projects Include="PdfViewerVCL.dproj">
            <Dependencies>PdfEngine.dproj</Dependencies>
        </Projects>
        <Projects Include="PdfViewerVCLDsgn.dproj">
            <Dependencies>PdfViewerVCL.dproj</Dependencies>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="PdfEngine">
        <MSBuild Projects="PdfEngine.dproj"/>
    </Target>
    <Target Name="PdfEngine:Clean">
        <MSBuild Projects="PdfEngine.dproj" Targets="Clean"/>
    </Target>
    <Target Name="PdfEngine:Make">
        <MSBuild Projects="PdfEngine.dproj" Targets="Make"/>
    </Target>
    <Target Name="PdfViewerFMX" DependsOnTargets="PdfEngine">
        <MSBuild Projects="PdfViewerFMX.dproj"/>
    </Target>
    <Target Name="PdfViewerFMX:Clean" DependsOnTargets="PdfEngine:Clean">
        <MSBuild Projects="PdfViewerFMX.dproj" Targets="Clean"/>
    </Target>
    <Target Name="PdfViewerFMX:Make" DependsOnTargets="PdfEngine:Make">
        <MSBuild Projects="PdfViewerFMX.dproj" Targets="Make"/>
    </Target>
    <Target Name="PdfViewerFMXDsgn" DependsOnTargets="PdfViewerFMX">
        <MSBuild Projects="PdfViewerFMXDsgn.dproj"/>
    </Target>
    <Target Name="PdfViewerFMXDsgn:Clean" DependsOnTargets="PdfViewerFMX:Clean">
        <MSBuild Projects="PdfViewerFMXDsgn.dproj" Targets="Clean"/>
    </Target>
    <Target Name="PdfViewerFMXDsgn:Make" DependsOnTargets="PdfViewerFMX:Make">
        <MSBuild Projects="PdfViewerFMXDsgn.dproj" Targets="Make"/>
    </Target>
    <Target Name="PdfViewerVCL" DependsOnTargets="PdfEngine">
        <MSBuild Projects="PdfViewerVCL.dproj"/>
    </Target>
    <Target Name="PdfViewerVCL:Clean" DependsOnTargets="PdfEngine:Clean">
        <MSBuild Projects="PdfViewerVCL.dproj" Targets="Clean"/>
    </Target>
    <Target Name="PdfViewerVCL:Make" DependsOnTargets="PdfEngine:Make">
